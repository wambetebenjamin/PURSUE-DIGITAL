# PURSUE server — configuration
#
# Copy to .env and edit. Every value here is optional: with no MONGODB_URI
# the server keeps its state in memory and says so in the log.

# The port to listen on.
PORT=8080

# The interface to bind. 0.0.0.0 so the server is reachable from outside
# the container it runs in.
HOST=0.0.0.0

# A MongoDB connection string. MongoDB Atlas is the easy one:
#   mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/pursue
# Leave it unset for the in-memory store (state is lost on restart).
# MONGODB_URI=
