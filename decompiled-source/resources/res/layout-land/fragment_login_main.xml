<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_gravity="center" android:id="@+id/login_panel" android:background="@drawable/icon_bg" android:layout_width="@dimen/gsdk_account_layout_landscape_width" android:layout_height="@dimen/gsdk_account_layout_landscape_height" android:layoutDirection="locale">
    <ImageView android:id="@+id/img_back" android:background="@drawable/icon_back" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:scaleType="center" android:layout_marginStart="8dp" android:layout_alignParentStart="true"/>
    <ImageView android:id="@+id/img_close" android:background="@drawable/icon_close" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:scaleType="center" android:layout_marginEnd="8dp" android:layout_alignParentEnd="true"/>
    <ImageView android:layout_gravity="center" android:id="@+id/img_logo" android:layout_width="144dp" android:layout_height="40dp" android:layout_marginTop="20dp" android:src="@drawable/logo" android:layout_centerHorizontal="true"/>
    <TextView android:gravity="center" android:id="@+id/cloud_config_error" android:background="@drawable/bg_cloud_config_error" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="83dp" android:layout_marginBottom="85dp" android:text="后台配置缺失" android:layout_marginStart="32dp" android:layout_marginEnd="32dp"/>
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/vertical_layout" android:visibility="visible" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="80dp" android:layout_marginStart="44dp" android:layout_marginEnd="44dp"/>
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/horizontal_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/vertical_layout">
        <androidx.recyclerview.widget.RecyclerView android:orientation="horizontal" android:id="@+id/horizontal_recycler_view" android:scrollbars="none" android:clipToPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:overScrollMode="never" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>
    <RelativeLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/login_bottom_container" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginTop="248dp" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" android:paddingStart="44dp" android:paddingEnd="44dp">
        <CheckBox android:id="@+id/cb_agree_protocol" android:background="@drawable/selector_user_agreement" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginTop="4dp" android:button="@null"/>
        <TextView android:textSize="12sp" android:textColor="@color/gsdk_account_8A8F99" android:gravity="start" android:id="@+id/tv_content_protocol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAlignment="textStart" android:layout_marginStart="8dp" android:layout_toEndOf="@+id/cb_agree_protocol" android:breakStrategy="simple" android:lineHeight="17dp"/>
    </RelativeLayout>
</RelativeLayout>
