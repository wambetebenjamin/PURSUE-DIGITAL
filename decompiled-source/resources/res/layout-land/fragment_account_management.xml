<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:id="@+id/login_panel" android:background="@drawable/icon_bg" android:layout_width="@dimen/gsdk_account_layout_landscape_width" android:layout_height="@dimen/gsdk_account_layout_landscape_height" android:layoutDirection="locale">
    <ImageView android:id="@+id/img_back" android:visibility="gone" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:src="@drawable/icon_back" android:scaleType="center" android:layout_marginStart="8dp" android:layout_alignParentStart="true"/>
    <ImageView android:id="@+id/img_close" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:layout_marginRight="8dp" android:src="@drawable/icon_close" android:scaleType="center" android:layout_alignParentRight="true" android:layout_marginEnd="8dp" android:layout_alignParentEnd="true"/>
    <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/gsdk_base_color_000000" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="16dp" android:text="@string/gsdk_account_account_management" android:layout_centerHorizontal="true"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerview" android:background="@drawable/shape_link_account_content" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="24dp" android:listSelector="@android:color/transparent" android:layout_below="@+id/title" android:layout_marginStart="30dp" android:layout_marginEnd="30dp"/>
</RelativeLayout>
