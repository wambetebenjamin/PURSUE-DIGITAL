<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:layout_width="match_parent" android:layout_height="64dp" android:layoutDirection="locale">
    <ImageView android:id="@+id/img_icon" android:layout_width="32dp" android:layout_height="32dp" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:layout_marginEnd="10dp" android:layout_alignParentStart="true"/>
    <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:ellipsize="end" android:id="@+id/tv_nickname" android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginTop="12dp" android:maxWidth="128dp" android:singleLine="true" android:textDirection="locale" android:layout_toEndOf="@+id/img_icon"/>
    <TextView android:textSize="11sp" android:textColor="@color/gsdk_account_theme_purple" android:gravity="center" android:id="@+id/tv_recently" android:background="@drawable/shape_auto_login_round_bg" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginTop="14dp" android:text="@string/gsdk_account_recent" android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginStart="6dp" android:layout_marginEnd="10dp" android:layout_toEndOf="@+id/tv_nickname"/>
    <TextView android:textSize="12sp" android:textColor="@color/gsdk_account_8A8F99" android:gravity="start|center_vertical" android:id="@+id/tv_last_login_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_below="@+id/tv_nickname" android:layout_toEndOf="@+id/img_icon"/>
    <ImageView android:id="@+id/img_delete_account" android:background="@drawable/icon_delete_account" android:layout_width="16dp" android:layout_height="16dp" android:layout_centerVertical="true" android:layout_marginEnd="16dp" android:layout_alignParentEnd="true"/>
</RelativeLayout>
