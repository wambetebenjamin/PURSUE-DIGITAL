<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@android:color/transparent" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:background="@drawable/dialog_background" android:layout_width="319dp" android:layout_height="307dp" android:layout_centerInParent="true">
        <FrameLayout android:layout_width="match_parent" android:layout_height="50dp">
            <ImageView android:layout_gravity="center_vertical" android:id="@+id/pay_cancel_check_close" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/oasis_ui_wechat_icon_x" android:layout_marginStart="16dp"/>
        </FrameLayout>
        <View android:id="@+id/pay_selection_divider" android:background="#1e161823" android:layout_width="match_parent" android:layout_height="1dp"/>
        <TextView android:textSize="20sp" android:textColor="#ff222222" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="48dp" android:text="确认取消支付么？"/>
        <TextView android:textSize="14sp" android:textColor="#ff505050" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="你离想要的物品只差一步..."/>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp">
            <TextView android:textSize="17sp" android:textColor="#ff999999" android:gravity="center" android:id="@+id/pay_cancel" android:background="@drawable/tv_cancel_background" android:layout_width="120dp" android:layout_height="44dp" android:text="取消"/>
            <TextView android:textSize="17sp" android:textColor="#ffffffff" android:gravity="center" android:id="@+id/pay_continue" android:background="@drawable/tv_agree_background" android:layout_width="120dp" android:layout_height="44dp" android:layout_marginLeft="12dp" android:text="继续支付"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
