<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:gravity="center" android:layout_gravity="center" android:orientation="vertical" android:id="@+id/dialog_pass_bind_tip" android:background="@drawable/shape_dialog_allow_pass_send_email_bg" android:layout_width="280dp" android:layout_height="wrap_content" android:layoutDirection="locale">
    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/gsdk_base_color_222222" android:gravity="center" android:id="@+id/tv_title" android:layout_width="240dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/gsdk_account_pass_created_bind_title" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
    <com.bytedance.ttgame.sdk.module.account.login.ui.view.MaxHeightScrollView android:layout_width="240dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fillViewport="false" app:max_height="190dp">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="14sp" android:textColor="@color/gsdk_base_color_222222" android:gravity="center" android:id="@+id/tv_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gsdk_account_pass_created_bind_text" android:textDirection="locale" android:lineHeight="21dp"/>
