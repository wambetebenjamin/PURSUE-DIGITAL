<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:background="@drawable/share_sdk_token_share_dialog_bg" android:layout_width="300dp" android:layout_height="425dp">
    <ImageView android:id="@+id/close_icon" android:paddingLeft="8dp" android:paddingTop="8dp" android:paddingRight="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/share_sdk_token_close_icon" android:layout_alignParentTop="true" android:layout_alignParentRight="true"/>
    <TextView android:textSize="19dp" android:textStyle="bold" android:textColor="#222222" android:ellipsize="end" android:gravity="center_horizontal" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:layout_marginBottom="5dp" android:text="@string/share_sdk_image_token_share_dialog_title" android:maxLines="1" android:layout_centerHorizontal="true"/>
    <TextView android:textSize="14dp" android:textColor="#999999" android:ellipsize="end" android:gravity="center_horizontal" android:id="@+id/token_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="24dp" android:layout_marginTop="6dp" android:layout_marginRight="24dp" android:text="@string/share_sdk_image_token_share_dialog_content" android:includeFontPadding="false" android:layout_below="@+id/title"/>
    <RelativeLayout android:layout_width="220dp" android:layout_height="274dp" android:layout_marginTop="24dp" android:layout_below="@+id/token_content" android:layout_centerHorizontal="true">
        <ImageView android:id="@+id/token_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:scaleType="fitXY" android:adjustViewBounds="true" android:layout_centerInParent="true"/>
    </RelativeLayout>
    <ScrollView android:id="@+id/token_long_image_container" android:background="@drawable/share_sdk_simple_image_holder" android:visibility="gone" android:scrollbars="none" android:layout_width="220dp" android:layout_height="274dp" android:layout_marginTop="24dp" android:layout_below="@+id/token_content" android:layout_centerHorizontal="true">
        <ImageView android:id="@+id/token_long_imageview" android:layout_width="match_parent" android:layout_height="wrap_content" android:scaleType="fitXY" android:adjustViewBounds="true"/>
    </ScrollView>
    <Button android:textSize="16dp" android:textColor="@color/share_sdk_token_dialog_bt_text" android:id="@+id/to_save_and_share_btn" android:background="@drawable/share_sdk_token_to_copy_bt_bg" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/share_sdk_save_and_share" android:layout_alignParentBottom="true"/>
</RelativeLayout>
