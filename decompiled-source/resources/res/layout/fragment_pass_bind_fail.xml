<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:id="@+id/login_panel" android:background="@drawable/icon_bg" android:layout_width="@dimen/gsdk_account_layout_portrait_width" android:layout_height="@dimen/gsdk_account_layout_portrait_height" android:layoutDirection="locale">
    <ImageView android:id="@+id/img_back" android:background="@drawable/icon_back" android:visibility="gone" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:scaleType="center" android:layout_marginStart="8dp" android:layout_alignParentStart="true"/>
    <ImageView android:id="@+id/img_close" android:background="@drawable/icon_close" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:scaleType="center" android:layout_marginEnd="8dp" android:layout_alignParentEnd="true"/>
    <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/gsdk_base_color_222222" android:gravity="center" android:layout_gravity="center" android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="70dp" android:text="@string/gsdk_account_pass_created_bind_failed_title" android:layout_centerHorizontal="true"/>
    <TextView android:textSize="14sp" android:textColor="@color/gsdk_account_565B66" android:gravity="center" android:id="@+id/tv_error" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/tv_title" android:paddingEnd="10dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
    <LinearLayout android:gravity="start|center_vertical" android:orientation="vertical" android:background="@drawable/shape_pass_bind_fail_info" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="16dp" android:layout_below="@+id/tv_error" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <TextView android:textSize="14sp" android:textColor="@android:color/black" android:id="@+id/tv_pass_name" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:textSize="12sp" android:textColor="#8a8f99" android:id="@+id/tv_pass_open_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <Button android:textSize="14sp" android:textColor="@color/white" android:id="@+id/btn_change_pass" android:background="@drawable/select_red_button_click" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="24dp" android:text="@string/gsdk_account_pass_settings_change_email_btn" android:layout_alignParentBottom="true" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
</RelativeLayout>
