<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:id="@+id/dialog_pass_register" android:layout_width="280dp" android:layout_height="wrap_content">
    <RelativeLayout android:gravity="center" android:background="@drawable/shape_dialog_allow_pass_send_email_bg" android:layout_width="280dp" android:layout_height="wrap_content" android:layoutDirection="locale">
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/gsdk_base_color_222222" android:gravity="center" android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/gsdk_email_address_title"/>
        <CheckBox android:id="@+id/cb_agree" android:background="@drawable/selector_user_agreement" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginTop="11dp" android:checked="true" android:button="@null" android:layout_below="@+id/tv_title" android:layout_marginStart="20dp" android:layout_alignParentStart="true"/>
        <ScrollView android:id="@+id/scrollView" android:scrollbars="none" android:layout_width="214dp" android:layout_height="120dp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:layout_below="@+id/tv_title" android:layout_marginStart="8dp" android:layout_marginEnd="20dp" android:layout_toEndOf="@+id/cb_agree">
            <TextView android:textSize="14sp" android:textColor="@android:color/black" android:gravity="start" android:id="@+id/tv_content" android:layout_width="214dp" android:layout_height="120dp" android:text="@string/gsdk_account_agree_marketing_email_text" android:textDirection="locale" android:textAlignment="textStart" android:lineHeight="21dp"/>
        </ScrollView>
        <Button android:textSize="14sp" android:textStyle="bold" android:textColor="@color/white" android:gravity="center" android:id="@+id/btn_confirm" android:background="@drawable/select_button_click" android:layout_width="134dp" android:layout_height="36dp" android:layout_marginBottom="20dp" android:text="@string/gsdk_account_pass_created_bind_confirm_btn" android:layout_below="@+id/scrollView" android:layout_centerHorizontal="true" android:textAllCaps="false"/>
    </RelativeLayout>
</FrameLayout>
