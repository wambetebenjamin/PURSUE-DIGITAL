<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:background="@drawable/share_sdk_token_share_dialog_bg" android:layout_width="260dp" android:layout_height="wrap_content">
    <ImageView android:id="@+id/share_close_iv" android:paddingLeft="8dp" android:paddingTop="8dp" android:paddingRight="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/share_sdk_token_close_icon" android:layout_alignParentTop="true" android:layout_alignParentRight="true"/>
    <TextView android:textSize="19dp" android:textStyle="bold" android:textColor="#222222" android:ellipsize="end" android:gravity="center_horizontal" android:id="@+id/share_title_tv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:text="@string/share_sdk_video_share_dialog_title" android:maxLines="1" android:layout_below="@+id/share_close_iv"/>
    <TextView android:textSize="15dp" android:textColor="#505050" android:ellipsize="end" android:gravity="top" android:id="@+id/share_content_tv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="14dp" android:layout_marginTop="9dp" android:layout_marginRight="14dp" android:text="视频已保存成功，请到微信上传视频分享。" android:lines="4" android:includeFontPadding="false" android:layout_below="@+id/share_title_tv"/>
    <Button android:textSize="16dp" android:textColor="@color/share_sdk_token_dialog_bt_text" android:id="@+id/continue_btn" android:background="@drawable/share_sdk_token_to_copy_bt_bg" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/share_sdk_save_and_share" android:layout_below="@+id/share_content_tv"/>
</RelativeLayout>
