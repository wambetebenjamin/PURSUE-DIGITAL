<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:background="@drawable/share_sdk_token_share_dialog_bg" android:layout_width="300dp" android:layout_height="wrap_content">
    <ImageView android:id="@+id/close_icon" android:paddingLeft="8dp" android:paddingTop="8dp" android:paddingRight="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/share_sdk_token_close_icon" android:layout_alignParentTop="true" android:layout_alignParentRight="true"/>
    <TextView android:textSize="17dp" android:textStyle="bold" android:textColor="#222222" android:ellipsize="end" android:gravity="center_horizontal" android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:layout_marginBottom="5dp" android:text="@string/share_sdk_token_share_dialog_title" android:maxLines="1" android:layout_below="@+id/close_icon"/>
    <TextView android:textSize="14dp" android:textColor="#222222" android:ellipsize="end" android:gravity="center_horizontal" android:id="@+id/token_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:lines="4" android:includeFontPadding="false" android:layout_below="@+id/title"/>
    <LinearLayout android:gravity="center" android:id="@+id/tips_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:layout_marginBottom="9dp" android:layout_below="@+id/token_content">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <ImageView android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:src="@drawable/share_sdk_token_share_report"/>
            <TextView android:textSize="12dp" android:textColor="@color/share_sdk_token_dialog_tips" android:ellipsize="end" android:layout_gravity="center_vertical" android:id="@+id/tips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <Button android:textSize="16dp" android:textColor="@color/share_sdk_token_dialog_bt_text" android:id="@+id/to_copy_btn" android:background="@drawable/share_sdk_token_to_copy_bt_bg" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/share_sdk_token_share_dialog_bt" android:layout_below="@+id/tips_layout"/>
</RelativeLayout>
