<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="@dimen/gsdk_account_layout_portrait_width" android:layout_height="@dimen/gsdk_account_layout_portrait_height">
    <ImageView android:id="@+id/img_back" android:layout_width="@dimen/gsdk_account_back_key_width" android:layout_height="@dimen/gsdk_account_back_key_width" android:layout_marginLeft="@dimen/gsdk_account_back_key_margin_left" android:layout_marginTop="@dimen/gsdk_account_back_key_margin_top" android:src="@drawable/icon_back" android:layout_marginStart="@dimen/gsdk_account_back_key_margin_left"/>
    <ImageView android:id="@+id/img_close" android:layout_width="@dimen/gsdk_account_back_key_width" android:layout_height="@dimen/gsdk_account_back_key_width" android:layout_marginTop="@dimen/gsdk_account_back_key_margin_top" android:layout_marginRight="@dimen/gsdk_account_back_key_margin_left" android:src="@drawable/icon_close" android:scaleType="center" android:layout_alignParentRight="true" android:layout_marginEnd="@dimen/gsdk_account_back_key_margin_left" android:layout_alignParentEnd="true"/>
    <TextView android:textSize="18sp" android:textColor="@color/gsdk_base_color_222222" android:id="@+id/tv_title" android:paddingTop="@dimen/gsdk_account_login_password_padding_top" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gsdk_account_bind_email" android:layout_centerHorizontal="true"/>
    <TextView android:textSize="12sp" android:textColor="@color/gsdk_base_color_999999" android:id="@+id/tv_bind_tip" android:paddingTop="@dimen/gsdk_account_set_login_password_tip_phone_padding_top" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gsdk_account_bind_email_tip" android:layout_below="@+id/tv_title" android:layout_centerHorizontal="true"/>
    <LinearLayout android:gravity="center" android:id="@+id/ll_mobile" android:paddingLeft="@dimen/gsdk_account_portrait_padding_left" android:paddingTop="40dp" android:paddingRight="@dimen/gsdk_account_portrait_padding_left" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/tv_bind_tip" android:paddingStart="@dimen/gsdk_account_portrait_padding_left" android:paddingEnd="@dimen/gsdk_account_portrait_padding_left">
        <EditText android:textSize="18sp" android:textColor="@color/gsdk_base_color_222222" android:textColorHint="@color/gsdk_account_color_hint_enter_pwd" android:id="@+id/et_email" android:background="@null" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/gsdk_account_hint_enter_email" android:singleLine="true" android:layout_weight="1"/>
        <ImageView android:id="@+id/img_clear_email" android:padding="5dp" android:visibility="gone" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/icon_clear_phone_num" android:scaleType="centerCrop" android:layout_toRightOf="@+id/et_phone_number" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/et_phone_number" android:layout_alignParentEnd="true"/>
        <View android:id="@+id/img_line" android:background="@color/gsdk_account_color_e8" android:visibility="gone" android:layout_width="1dp" android:layout_height="15dp" android:layout_toRightOf="@+id/et_mobile" android:layout_toEndOf="@+id/et_mobile"/>
        <TextView android:textSize="17sp" android:textColor="@color/gsdk_base_color_222222" android:gravity="center" android:id="@+id/send_code" android:clickable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="9dp" android:text="@string/gsdk_account_send_verification_code" android:singleLine="true" android:layout_marginStart="9dp"/>
    </LinearLayout>
    <View android:id="@+id/line_mobile" android:background="@color/gsdk_account_color_e8" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginLeft="@dimen/gsdk_account_portrait_padding_left" android:layout_marginTop="@dimen/gsdk_account_line_padding_top" android:layout_marginRight="@dimen/gsdk_account_portrait_padding_left" android:layout_below="@+id/ll_mobile" android:layout_marginStart="@dimen/gsdk_account_portrait_padding_left" android:layout_marginEnd="@dimen/gsdk_account_portrait_padding_left"/>
    <LinearLayout android:gravity="center" android:id="@+id/ll_password" android:paddingLeft="@dimen/gsdk_account_portrait_padding_left" android:paddingTop="27dp" android:paddingRight="@dimen/gsdk_account_portrait_padding_left" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@+id/line_mobile" android:paddingStart="@dimen/gsdk_account_portrait_padding_left" android:paddingEnd="@dimen/gsdk_account_portrait_padding_left">
        <EditText android:textSize="18sp" android:textColor="@color/gsdk_base_color_222222" android:textColorHint="@color/gsdk_account_color_hint_enter_pwd" android:id="@+id/et_code" android:background="@null" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/gsdk_account_hint_input_verification_code" android:singleLine="true" android:layout_weight="1"/>
        <ImageView android:id="@+id/img_clear_code" android:padding="5dp" android:visibility="gone" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/icon_clear_phone_num" android:scaleType="centerCrop" android:layout_toRightOf="@+id/et_phone_number" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:layout_toEndOf="@+id/et_phone_number" android:layout_alignParentEnd="true"/>
    </LinearLayout>
    <View android:id="@+id/line_password" android:background="@color/gsdk_account_color_e8" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginLeft="@dimen/gsdk_account_portrait_padding_left" android:layout_marginTop="@dimen/gsdk_account_line_padding_top" android:layout_marginRight="@dimen/gsdk_account_portrait_padding_left" android:layout_below="@+id/ll_password" android:layout_marginStart="@dimen/gsdk_account_portrait_padding_left" android:layout_marginEnd="@dimen/gsdk_account_portrait_padding_left"/>
    <Button android:enabled="false" android:textSize="16sp" android:textColor="@android:color/white" android:id="@+id/btn_ok" android:background="@drawable/selector_button_next" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginLeft="@dimen/gsdk_account_portrait_padding_left" android:layout_marginTop="40dp" android:layout_marginRight="@dimen/gsdk_account_portrait_padding_left" android:text="@string/gsdk_account_confirm" android:layout_below="@+id/line_password" android:layout_marginStart="@dimen/gsdk_account_portrait_padding_left" android:layout_marginEnd="@dimen/gsdk_account_portrait_padding_left"/>
</RelativeLayout>
