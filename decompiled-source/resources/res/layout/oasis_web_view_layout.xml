<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:id="@+id/web_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout android:id="@+id/web_title_container" android:background="#333333" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:id="@+id/web_title" android:layout_width="match_parent" android:layout_height="40dp" app:layout_scrollFlags="enterAlways|scroll">
            <TextView android:textSize="20sp" android:textColor="#b8b8b8" android:ellipsize="end" android:gravity="center_horizontal" android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:maxEms="16" android:singleLine="true" android:drawablePadding="5dp" android:layout_centerInParent="true" android:scaleX="0.8" android:scaleY="0.8"/>
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView android:orientation="vertical" android:id="@+id/web_activity_web_container" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="match_parent" app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <WebView android:id="@+id/web_view" android:padding="0dp" android:clipToPadding="true" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="0dp"/>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar android:id="@+id/progress_bar" android:visibility="gone" android:layout_width="match_parent" android:layout_height="3dp" android:progressDrawable="@drawable/progress_bar" app:layout_anchor="@+id/web_activity_web_container" app:layout_anchorGravity="start" style="?android:attr/progressBarStyleHorizontal"/>
    <RelativeLayout android:layout_gravity="bottom" android:id="@+id/web_bottom" android:background="#333333" android:clickable="true" android:layout_width="match_parent" android:layout_height="45dp" android:layoutDirection="locale" app:layout_behavior="com.oasis.android.BottomNavigationViewBehavior">
        <ImageView android:id="@+id/btn_back" android:padding="5dp" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/oasis_ui_web_btn_back" android:layout_centerVertical="true" android:onClick="onClickBtnBack" android:layout_marginStart="30dp" android:layout_alignParentStart="true"/>
        <ImageView android:id="@+id/btn_forward" android:padding="5dp" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/oasis_ui_web_btn_forward" android:layout_centerVertical="true" android:onClick="onClickBtnForward" android:layout_marginStart="34dp" android:layout_toEndOf="@+id/btn_back"/>
        <ImageView android:id="@+id/btn_refresh" android:padding="5dp" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/oasis_ui_web_reload" android:layout_centerVertical="true" android:onClick="onClickBtnRefresh" android:layout_marginStart="38dp" android:layout_toEndOf="@+id/btn_forward"/>
        <ImageView android:id="@+id/btn_close" android:padding="5dp" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/oasis_ui_web_rollback" android:layout_centerVertical="true" android:onClick="onClickBtnClose" android:layout_toStartOf="@+id/tv_close"/>
        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#b8b8b8" android:gravity="center" android:id="@+id/tv_close" android:layout_width="wrap_content" android:layout_height="30dp" android:maxWidth="100dp" android:text="@string/return_game" android:maxLines="1" android:layout_centerVertical="true" android:onClick="onClickBtnClose" android:layout_marginEnd="20dp" android:layout_alignParentEnd="true" app:autoSizeMaxTextSize="16sp" app:autoSizeMinTextSize="8sp" app:autoSizeTextType="uniform"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
