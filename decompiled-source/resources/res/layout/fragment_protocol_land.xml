<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:id="@+id/login_panel_background" android:layout_width="@dimen/gsdk_base_layout_landscape_width" android:layout_height="@dimen/gsdk_base_layout_landscape_height" android:layoutDirection="locale">
    <androidx.constraintlayout.widget.ConstraintLayout android:orientation="vertical" android:id="@+id/login_panel" android:tag="skin:shape_background:background" android:background="@drawable/shape_background" android:layout_width="@dimen/gsdk_base_layout_landscape_width" android:layout_height="@dimen/gsdk_base_layout_landscape_height">
        <ImageView android:id="@+id/img_back" android:visibility="gone" android:layout_width="@dimen/gsdk_account_back_key_width" android:layout_height="@dimen/gsdk_account_back_key_width" android:layout_marginTop="9dp" android:src="@drawable/icon_back" android:layout_marginStart="9dp" app:layout_constraintStart_toStartOf="0" app:layout_constraintTop_toTopOf="0"/>
        <ImageView android:id="@+id/img_close" android:visibility="visible" android:layout_width="@dimen/gsdk_account_back_key_width" android:layout_height="@dimen/gsdk_account_back_key_width" android:layout_marginTop="9dp" android:src="@drawable/icon_close" android:layout_marginEnd="9dp" app:layout_constraintEnd_toEndOf="0" app:layout_constraintTop_toTopOf="0"/>
        <RadioGroup android:orientation="horizontal" android:id="@+id/rg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="30dp" app:layout_constraintLeft_toLeftOf="0" app:layout_constraintRight_toRightOf="0" app:layout_constraintTop_toTopOf="0">
            <RadioButton android:textSize="16sp" android:textColor="@drawable/select_radio_check" android:gravity="center" android:layout_gravity="center" android:id="@+id/rb_one" android:tag="skin:selector_radio_button_underline:background" android:background="@color/transparent" android:paddingLeft="12.5dp" android:paddingRight="12.5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:button="@null" android:text="@string/gsdk_account_user_agree"/>
            <RadioButton android:textSize="16sp" android:textColor="@drawable/select_radio_check" android:gravity="center" android:layout_gravity="center" android:id="@+id/rb_two" android:tag="skin:selector_radio_button_underline:background" android:background="@color/transparent" android:paddingLeft="12.5dp" android:paddingRight="12.5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:button="@null" android:text="@string/gsdk_account_privacy_policy"/>
        </RadioGroup>
        <FrameLayout android:layout_gravity="center" android:orientation="vertical" android:id="@+id/webview_parent" android:visibility="visible" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginLeft="30dp" android:layout_marginTop="16dp" android:layout_marginRight="30dp" app:layout_constrainedHeight="true" app:layout_constraintBottom_toTopOf="@+id/btn_accept" app:layout_constraintEnd_toEndOf="0" app:layout_constraintHeight_default="spread" app:layout_constraintTop_toBottomOf="@+id/rg" app:layout_goneMarginBottom="30dp"/>
        <TextView android:textSize="12sp" android:textColor="@color/gsdk_base_color_999999" android:gravity="start" android:id="@+id/tv_did_tip" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toLeftOf="@+id/img_close" android:layout_alignParentLeft="true" android:textDirection="locale" android:layout_toStartOf="@+id/img_close" android:layout_alignParentStart="true" app:layout_constraintTop_toTopOf="0"/>
        <Button android:textSize="14sp" android:textColor="@android:color/white" android:id="@+id/btn_accept" android:tag="skin:selector_button_ok:background" android:background="@drawable/protocol_selector_button_ok" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:text="@string/gsdk_account_accept" android:textAllCaps="false" android:layout_marginStart="30dp" android:layout_marginEnd="30dp" app:layout_constraintBottom_toTopOf="@+id/btn_disagree" app:layout_constraintEnd_toEndOf="0" app:layout_constraintStart_toStartOf="0" app:layout_constraintTop_toBottomOf="@+id/webview_parent"/>
        <TextView android:textSize="14sp" android:gravity="center" android:id="@+id/btn_disagree" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:text="@string/gsdk_account_disagree" android:textAllCaps="false" app:layout_constraintBottom_toBottomOf="0" app:layout_constraintHorizontal_chainStyle="packed" app:layout_constraintStart_toStartOf="0" app:layout_constraintTop_toBottomOf="@+id/btn_accept"/>
        <androidx.constraintlayout.widget.Group android:id="@+id/ll_countersign" android:layout_width="wrap_content" android:layout_height="wrap_content" app:constraint_referenced_ids="btn_accept,btn_disagree"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
