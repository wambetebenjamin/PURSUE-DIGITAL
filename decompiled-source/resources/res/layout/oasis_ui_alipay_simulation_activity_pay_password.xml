<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:background="#ff313f59" android:layout_width="match_parent" android:layout_height="match_parent">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="70dp">
            <TextView android:textSize="15sp" android:textColor="#ffffffff" android:id="@+id/pay_password_title_account" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true"/>
            <ImageView android:id="@+id/pay_password_title_avatar" android:layout_width="20dp" android:layout_height="20dp" android:layout_centerVertical="true" android:layout_marginEnd="8dp" android:layout_toStartOf="@+id/pay_password_title_account"/>
        </RelativeLayout>
    </FrameLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/dialog_background_no_bottom" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="70dp" android:layout_alignParentBottom="true">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="46dp">
            <ImageView android:id="@+id/pay_password_close" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginLeft="15dp" android:src="@drawable/oasis_ui_alipay_icon_close" android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout android:gravity="center_horizontal" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="15sp" android:textColor="#ff333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="上海源庄数码科技有限公司"/>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="4dp">
                <TextView android:textSize="38sp" android:textStyle="bold" android:textColor="#ff333333" android:gravity="center" android:id="@+id/pay_password_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_centerInParent="true" android:fontFamily="@font/alipay_number_font"/>
                <TextView android:textSize="22sp" android:textStyle="bold" android:textColor="#ff333333" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="￥" android:layout_toLeftOf="@+id/pay_password_amount" android:layout_alignBaseline="@+id/pay_password_amount" android:fontFamily="@font/alipay_number_font"/>
            </RelativeLayout>
            <RelativeLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="27dp" android:layout_marginTop="20dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
                <TextView android:textSize="15sp" android:textColor="#ff999999" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账号"/>
                <TextView android:textSize="15sp" android:textColor="#ff333333" android:id="@+id/pay_password_account" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View android:background="#fff5f5f5" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>
            <RelativeLayout android:id="@+id/pay_password_relative_layout" android:layout_width="match_parent" android:layout_height="27dp" android:layout_marginTop="10dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
                <TextView android:textSize="15sp" android:textColor="#ff999999" android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginTop="1.5dp" android:text="付款方式"/>
                <TextView android:textSize="15sp" android:textColor="#ff333333" android:id="@+id/pay_password_card" android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginTop="1.5dp" android:includeFontPadding="false" android:layout_alignParentEnd="true"/>
                <ImageView android:id="@+id/pay_password_image" android:layout_width="16dp" android:layout_height="16dp" android:layout_marginRight="10dp" android:src="@drawable/oasis_ui_alipay_input_password_zhaoshang_bank" android:layout_centerVertical="true" android:layout_toStartOf="@+id/pay_password_card"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/pay_password_container" android:layout_width="match_parent" android:layout_height="match_parent" android:animateLayoutChanges="true">
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:fillViewport="true" android:layout_weight="1">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="vertical" android:background="#fff7f8f9" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_marginRight="12dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="38dp">
                            <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="#ff999999" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支付工具" android:layout_centerVertical="true" android:layout_marginStart="16dp"/>
                        </RelativeLayout>
                        <View android:background="#fff5f5f5" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp"/>
                        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <RelativeLayout android:id="@+id/pay_password_card_selection" android:layout_width="match_parent" android:layout_height="44dp">
                                <ImageView android:id="@+id/pay_password_card_image" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/oasis_ui_alipay_input_password_zhaoshang_bank" android:layout_centerVertical="true" android:layout_marginStart="16dp"/>
                                <TextView android:textSize="15sp" android:textColor="#ff333333" android:id="@+id/pay_password_card_text" android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginTop="10.5dp" android:includeFontPadding="false" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/pay_password_card_image"/>
                                <ImageView android:id="@+id/pay_password_card_checked" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/oasis_ui_alipay_icon_checked" android:layout_centerVertical="true" android:layout_marginEnd="16dp" android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                            <RelativeLayout android:id="@+id/pay_password_card_selection_2" android:layout_width="match_parent" android:layout_height="44dp">
                                <ImageView android:id="@+id/pay_password_card_image_2" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/oasis_ui_alipay_input_password_jianshe_bank" android:layout_centerVertical="true" android:layout_marginStart="16dp"/>
                                <TextView android:textSize="15sp" android:textColor="#ff333333" android:id="@+id/pay_password_card_text_2" android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginTop="10.5dp" android:includeFontPadding="false" android:layout_marginStart="10dp" android:layout_toEndOf="@+id/pay_password_card_image_2"/>
                                <ImageView android:id="@+id/pay_password_card_checked_2" android:visibility="gone" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/oasis_ui_alipay_icon_checked" android:layout_centerVertical="true" android:layout_marginEnd="16dp" android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <View android:background="#fff5f5f5" android:layout_width="match_parent" android:layout_height="1dp"/>
                        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <RelativeLayout android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="10dp">
                                <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="#ff999999" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资金渠道" android:layout_centerVertical="true" android:layout_marginStart="16dp"/>
                            </RelativeLayout>
                            <View android:background="#fff5f5f5" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp"/>
                            <TextView android:textSize="13sp" android:textColor="#ff999999" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:text="货币基金赎回资金" android:layout_marginStart="16dp"/>
                            <RelativeLayout android:layout_width="match_parent" android:layout_height="63dp">
                                <TextView android:textSize="15sp" android:textColor="#ff333333" android:id="@+id/pay_password_yeb" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="42dp" android:layout_marginTop="12dp" android:text="余额宝"/>
                                <ImageView android:id="@+id/imageView" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/oasis_ui_alipay_input_password_yeb" android:layout_alignBottom="@+id/pay_password_yeb" android:layout_marginEnd="-32dp" android:layout_toStartOf="@+id/pay_password_yeb"/>
                                <TextView android:textSize="13sp" android:textColor="#ff999999" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="由网商银行提供服务" android:layout_marginStart="42dp"/>
                                <ImageView android:visibility="gone" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/oasis_ui_alipay_icon_checked" android:layout_alignBottom="@+id/pay_password_yeb" android:layout_marginEnd="16dp" android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/pay_password_more" android:background="#fff7f8f9" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginLeft="12dp" android:layout_marginRight="12dp">
                        <TextView android:textSize="13sp" android:textColor="#ff999999" android:id="@+id/pay_password_more_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="查看全部"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/oasis_ui_alipay_icon_arrow_down" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
                </LinearLayout>
            </ScrollView>
            <TextView android:textSize="18sp" android:textColor="#ffffffff" android:gravity="center" android:id="@+id/pay_password_continue" android:background="#ff1677ff" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginLeft="16dp" android:layout_marginTop="16dp" android:layout_marginRight="16dp" android:text="确认付款"/>
            <TextView android:textSize="14sp" android:textColor="#ffcccccc" android:gravity="center" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginTop="12dp" android:layout_marginBottom="20dp" android:text="本服务由支付宝(杭州)信息技术有限公司提供"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
