<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_gravity="center" android:id="@+id/login_panel" android:background="@drawable/icon_bg" android:layout_width="@dimen/gsdk_account_layout_portrait_width" android:layout_height="@dimen/gsdk_account_layout_portrait_height" android:layoutDirection="locale">
    <ImageView android:id="@+id/img_back" android:background="@drawable/icon_back" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:scaleType="center" android:layout_marginStart="8dp" android:layout_alignParentStart="true"/>
    <ImageView android:id="@+id/img_close" android:background="@drawable/icon_close" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:scaleType="center" android:layout_marginEnd="8dp" android:layout_alignParentEnd="true"/>
    <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/gsdk_base_color_222222" android:gravity="center" android:layout_gravity="center" android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="72dp" android:text="@string/gsdk_email_address_title" android:layout_centerHorizontal="true"/>
    <TextView android:textSize="14sp" android:textColor="@color/gsdk_account_565B66" android:gravity="center" android:id="@+id/tv_email_tip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:text="@string/gsdk_account_pass_email_input_text" android:layout_below="@+id/tv_title" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
    <include android:id="@+id/rl_input_box" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="20dp" android:layout_below="@+id/tv_email_tip" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" layout="@layout/custom_clearedittext"/>
    <Button android:enabled="false" android:textSize="14sp" android:textColor="@color/white" android:id="@+id/btn_next" android:background="@drawable/select_button_click" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="24dp" android:text="@string/gsdk_account_next_step" android:layout_alignParentBottom="true" android:textAllCaps="false" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
</RelativeLayout>
