<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_gravity="center" android:orientation="vertical" android:background="@drawable/fill_stroke" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="15sp" android:textColor="#5c5c5c" android:gravity="center" android:paddingTop="20dp" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="15dp" android:layout_marginRight="15dp" android:text="@string/gsdk_push_permission_alert_dialog_content"/>
        <LinearLayout android:background="#eee" android:layout_width="match_parent" android:layout_height="1dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="#999" android:ellipsize="end" android:gravity="center" android:id="@+id/btn_cancel" android:paddingTop="15dp" android:paddingBottom="15dp" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/gsdk_push_permission_alert_dialog_btn_later" android:maxLines="1" android:includeFontPadding="false" android:layout_weight="1"/>
            <LinearLayout android:background="#eee" android:layout_width="1dp" android:layout_height="match_parent"/>
            <TextView android:textColor="#594af0" android:ellipsize="end" android:gravity="center" android:id="@+id/btn_confirm" android:paddingTop="15dp" android:paddingBottom="15dp" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/gsdk_push_permission_alert_dialog_btn_enable" android:maxLines="1" android:includeFontPadding="false" android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
