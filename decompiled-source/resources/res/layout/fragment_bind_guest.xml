<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:id="@+id/login_panel" android:background="@drawable/icon_bg" android:paddingBottom="26dp" android:layout_width="@dimen/gsdk_account_layout_portrait_width" android:layout_height="@dimen/gsdk_account_layout_portrait_height" android:layoutDirection="locale">
    <Button android:textSize="14sp" android:textColor="@color/gsdk_base_color_666666" android:id="@+id/btn_cancel" android:background="@drawable/shape_bind_cancel" android:layout_width="120dp" android:layout_height="42dp" android:layout_marginLeft="18dp" android:text="@string/gsdk_account_cancel" android:layout_alignParentLeft="true" android:layout_alignParentBottom="true" android:textAllCaps="false" android:layout_marginStart="18dp" android:layout_alignParentStart="true" style="?android:attr/borderlessButtonStyle"/>
    <Button android:textSize="14sp" android:textColor="@color/white" android:id="@+id/btn_confirm" android:background="@drawable/select_button_click" android:layout_width="120dp" android:layout_height="42dp" android:layout_marginRight="18dp" android:text="@string/gsdk_account_go_bind" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:textAllCaps="false" android:layout_marginEnd="18dp" android:layout_alignParentEnd="true" style="?android:attr/borderlessButtonStyle"/>
    <ImageView android:id="@+id/img_login_type" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:layout_below="@+id/tv_title" android:layout_centerHorizontal="true"/>
    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/gsdk_base_color_222222" android:gravity="center" android:id="@+id/tv_title" android:paddingLeft="22dp" android:paddingTop="32dp" android:paddingRight="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gsdk_account_bind_or_register" android:maxLines="2" android:layout_centerHorizontal="true" android:paddingStart="22dp" android:paddingEnd="22dp"/>
    <ScrollView android:paddingLeft="20dp" android:paddingRight="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="22dp" android:layout_above="@+id/btn_cancel" android:layout_below="@+id/img_login_type" android:paddingStart="20dp" android:paddingEnd="20dp">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:paddingLeft="3dp" android:paddingRight="3dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_above="@+id/btn_cancel" android:paddingStart="3dp" android:paddingEnd="3dp">
            <TextView android:textSize="14sp" android:textColor="@color/gsdk_base_color_222222" android:id="@+id/tv_bind_guest_tip" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gsdk_account_bind_guest_account_tip" android:lineSpacingExtra="4dp"/>
            <TextView android:textSize="14sp" android:textColor="@color/gsdk_base_color_666666" android:id="@+id/tv_bind_guest_addition_tip" android:paddingTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/gsdk_account_bind_guest_addition_account_tip" android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
