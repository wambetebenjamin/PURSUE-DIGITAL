<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:orientation="vertical" android:id="@+id/login_panel" android:background="@drawable/icon_bg" android:layout_width="@dimen/gsdk_account_layout_portrait_width" android:layout_height="@dimen/gsdk_account_layout_portrait_height" android:layoutDirection="locale">
    <ImageView android:id="@+id/img_close" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:src="@drawable/icon_close" android:layout_marginEnd="8dp" android:layout_alignParentEnd="true"/>
    <ImageView android:layout_gravity="center" android:id="@+id/img_logo" android:layout_width="144dp" android:layout_height="40dp" android:layout_marginTop="24dp" android:src="@drawable/logo" android:layout_centerHorizontal="true"/>
    <RelativeLayout android:layout_gravity="center" android:id="@+id/rl_current_acount" android:background="@drawable/shape_current_account" android:visibility="visible" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="96dp" android:layout_centerHorizontal="true" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
        <ImageView android:id="@+id/img_icon" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentLeft="true" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:layout_marginEnd="10dp" android:layout_alignParentStart="true"/>
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" android:ellipsize="end" android:id="@+id/tv_nickname" android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginTop="12dp" android:maxWidth="114dp" android:singleLine="true" android:textDirection="locale" android:layout_toEndOf="@+id/img_icon"/>
        <TextView android:textSize="11sp" android:textColor="@color/gsdk_account_theme_purple" android:gravity="center" android:id="@+id/tv_last_login_tip" android:background="@drawable/shape_auto_login_round_bg" android:layout_width="wrap_content" android:layout_height="16dp" android:layout_marginTop="14dp" android:text="@string/gsdk_account_recent" android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginStart="6dp" android:layout_toEndOf="@+id/tv_nickname"/>
        <TextView android:textSize="12sp" android:textColor="@color/gsdk_account_8A8F99" android:gravity="start|center_vertical" android:id="@+id/tv_last_login_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_below="@+id/tv_nickname" android:layout_toStartOf="@+id/img_show_all_count" android:layout_toEndOf="@+id/img_icon"/>
        <ImageView android:id="@+id/img_show_all_count" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/icon_down" android:layout_centerVertical="true" android:layout_marginEnd="16dp" android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView android:textSize="14sp" android:textColor="@color/gsdk_account_theme_purple" android:gravity="center" android:id="@+id/tv_more" android:visibility="visible" android:clickable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minWidth="100dp" android:text="@string/gsdk_account_login_another_account" android:layout_below="@+id/btn_enter_game" android:layout_centerHorizontal="true" android:textAllCaps="false" android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>
    <Button android:textSize="16sp" android:textColor="@android:color/white" android:layout_gravity="center" android:id="@+id/btn_enter_game" android:background="@drawable/select_button_click" android:visibility="visible" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="24dp" android:text="@string/gsdk_account_enter_game" android:layout_below="@+id/rl_current_acount" android:textAllCaps="false" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" style="?android:attr/borderlessButtonStyle"/>
</RelativeLayout>
