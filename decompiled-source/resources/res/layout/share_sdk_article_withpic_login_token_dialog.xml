<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:orientation="vertical" android:background="@drawable/share_sdk_token_dialog_bg" android:layout_width="300dp" android:layout_height="338dp">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
        <ImageView android:id="@+id/close_icon" android:padding="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/share_sdk_token_close_icon"/>
    </LinearLayout>
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/content_layout" android:paddingLeft="15dp" android:paddingRight="15dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:textSize="17dp" android:textColor="#222222" android:ellipsize="end" android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:maxLines="2" android:lineSpacingMultiplier="1.14"/>
        <ImageView android:layout_gravity="center_horizontal" android:id="@+id/cover_img" android:background="@drawable/share_sdk_simple_image_holder" android:layout_width="270dp" android:layout_height="152dp" android:layout_centerInParent="true"/>
    </LinearLayout>
    <RelativeLayout android:gravity="fill" android:id="@+id/share_user_info_layout" android:paddingLeft="15dp" android:paddingRight="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="16dp">
        <TextView android:textSize="14dp" android:textColor="#999999" android:id="@+id/look_share_user" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="，查看TA" android:maxLines="1" android:drawableRight="@drawable/share_sdk_token_right_arrow" android:layout_alignParentRight="true"/>
        <TextView android:textSize="14dp" android:textColor="#999999" android:ellipsize="end" android:id="@+id/share_user_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:layout_toLeftOf="@+id/look_share_user"/>
    </RelativeLayout>
    <Button android:textSize="16dp" android:textColor="#ffffff" android:id="@+id/token_btn" android:background="@drawable/share_sdk_token_to_copy_bt_bg" android:layout_width="match_parent" android:layout_height="44dp" android:text="查看" android:layout_below="@+id/share_user_info"/>
</LinearLayout>
