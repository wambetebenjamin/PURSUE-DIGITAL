<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_gravity="center" android:orientation="vertical" android:layout_width="300dp" android:layout_height="462dp">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginBottom="-6dp" android:layout_weight="1">
        <ImageView android:id="@+id/cover_img" android:background="@drawable/share_sdk_simple_image_holder" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
        <ImageView android:id="@+id/cover_img_play_btn" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/share_sdk_cover_play_new" android:scaleType="center" android:layout_centerInParent="true"/>
        <View android:background="@drawable/share_sdk_tiktok_token_dialog_title_bg" android:layout_width="match_parent" android:layout_height="160dp" android:layout_alignParentBottom="true"/>
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="22dp" android:layout_alignParentBottom="true">
            <TextView android:textSize="17dp" android:textColor="#ffffff" android:ellipsize="end" android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="15dp" android:layout_marginRight="15dp" android:text="测试标题" android:lineSpacingMultiplier="1.14"/>
            <RelativeLayout android:gravity="fill" android:id="@+id/share_user_info_layout" android:paddingLeft="15dp" android:paddingRight="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <TextView android:textSize="14dp" android:textColor="#ffffff" android:id="@+id/look_share_user" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="，查看TA" android:maxLines="1" android:drawableRight="@drawable/share_sdk_token_right_arrow" android:layout_alignParentRight="true"/>
                <TextView android:textSize="14dp" android:textColor="#ffffff" android:ellipsize="end" android:id="@+id/share_user_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:layout_toLeftOf="@+id/look_share_user"/>
            </RelativeLayout>
        </LinearLayout>
        <ImageView android:id="@+id/close_icon" android:padding="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/share_sdk_token_close_icon_white" android:layout_alignParentTop="true" android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <Button android:textSize="16dp" android:textColor="#ffffff" android:id="@+id/token_btn" android:background="@drawable/share_sdk_token_to_copy_bt_bg" android:layout_width="match_parent" android:layout_height="44dp" android:text="查看" android:layout_below="@+id/share_user_info"/>
</LinearLayout>
