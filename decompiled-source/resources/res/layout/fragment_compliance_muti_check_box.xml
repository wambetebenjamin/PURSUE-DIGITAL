<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_gravity="center" android:id="@+id/login_panel" android:background="@drawable/icon_bg" android:layout_width="@dimen/gsdk_account_layout_portrait_width" android:layout_height="@dimen/gsdk_account_layout_landscape_height" android:layoutDirection="locale">
    <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" android:layout_gravity="top" android:id="@+id/use_policy" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="25dp" android:layout_marginTop="24dp" android:button="@null" android:text="@string/gsdk_compliance_use_policy" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
    <TextView android:textSize="14sp" android:textColor="@color/gsdk_account_8A8F99" android:gravity="center" android:layout_gravity="top" android:id="@+id/rb_two" android:background="@color/transparent" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="12dp" android:button="@null" android:text="@string/gsdk_compliance_read_before_game" android:layout_below="@+id/use_policy" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
    <LinearLayout android:gravity="start|center_vertical" android:orientation="horizontal" android:id="@+id/protocol_introduction" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="16dp" android:layout_below="@+id/rb_two" android:paddingStart="0dp" android:paddingEnd="0dp" android:layout_marginStart="24dp">
        <CheckBox android:id="@+id/cb_protocol_introduction" android:background="@drawable/selector_user_agreement" android:layout_width="12dp" android:layout_height="12dp" android:button="@null"/>
        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="start" android:id="@+id/tv_protocol_introduction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gsdk_compliance_have_read_protocol_introduction" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:gravity="start|center_vertical" android:orientation="horizontal" android:id="@+id/policy_introduction" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="12dp" android:layout_below="@+id/protocol_introduction" android:paddingStart="0dp" android:paddingEnd="0dp" android:layout_marginStart="24dp">
        <CheckBox android:id="@+id/cb_policy_introduction" android:background="@drawable/selector_user_agreement" android:layout_width="12dp" android:layout_height="12dp" android:button="@null"/>
        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="start" android:id="@+id/tv_policy_introduction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gsdk_compliance_have_read_policy_introduction" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:gravity="start|center_vertical" android:orientation="horizontal" android:id="@+id/age_gate_year_limit" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="12dp" android:layout_below="@+id/policy_introduction" android:paddingStart="0dp" android:paddingEnd="0dp" android:layout_marginStart="24dp">
        <CheckBox android:id="@+id/cb_age_gate_year_limit" android:background="@drawable/selector_user_agreement" android:layout_width="12dp" android:layout_height="12dp" android:button="@null"/>
        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="start" android:id="@+id/tv_age_gate_year_limit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gsdk_compliance_age_gate" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:gravity="start|center_vertical" android:orientation="horizontal" android:id="@+id/agree_all" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="12dp" android:layout_below="@+id/age_gate_year_limit" android:paddingStart="0dp" android:paddingEnd="0dp" android:layout_marginStart="24dp">
        <CheckBox android:id="@+id/cb_agree_all" android:background="@drawable/selector_user_agreement" android:layout_width="12dp" android:layout_height="12dp" android:button="@null"/>
        <TextView android:textSize="14sp" android:textColor="@color/black" android:gravity="start" android:id="@+id/tv_agree_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gsdk_compliance_agree_all" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:gravity="center" android:id="@+id/ll_countersign" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="17dp" android:layout_below="@+id/agree_all" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
        <Button android:textSize="14sp" android:textColor="@color/gsdk_account_565B66" android:gravity="center" android:id="@+id/btn_disagree" android:background="@drawable/shape_enter_game_gray" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/gsdk_compliance_back" android:layout_weight="1" android:textAllCaps="false" android:layout_marginEnd="8dp" style="?android:attr/borderlessButtonStyle"/>
        <Button android:textSize="14sp" android:textColor="@android:color/white" android:id="@+id/btn_accept" android:background="@drawable/select_button_click" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/gsdk_account_age_gate_date_select_dialog_btn_continue_content" android:layout_weight="1" android:textAllCaps="false" android:layout_marginStart="8dp" style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</RelativeLayout>
