<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@drawable/gsdk_rating_default_dialog_bg" android:layout_width="260dp" android:layout_height="match_parent">
    <ImageView android:id="@+id/icon_app" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="15dp" android:layout_centerHorizontal="true"/>
    <TextView android:textSize="16sp" android:textColor="#000000" android:gravity="center" android:id="@+id/dialog_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:layout_below="@+id/icon_app" android:layout_centerHorizontal="true" android:layout_marginStart="15dp" android:layout_marginEnd="15dp"/>
    <View android:id="@+id/horizontal_divider" android:background="@color/gsdk_rating_divider" android:layout_width="match_parent" android:layout_height="1px" android:layout_marginTop="15dp" android:layout_below="@+id/dialog_title"/>
    <View android:id="@+id/vertical_divider" android:background="@color/gsdk_rating_divider" android:layout_width="1px" android:layout_height="45dp" android:layout_below="@+id/horizontal_divider" android:layout_centerHorizontal="true"/>
    <Button android:textSize="16sp" android:textColor="#7d7d7d" android:gravity="center" android:id="@+id/cancel" android:background="@null" android:layout_width="wrap_content" android:layout_height="45dp" android:text="@string/gsdk_rating_cannel" android:singleLine="true" android:layout_below="@+id/horizontal_divider" android:textAllCaps="false" android:layout_toStartOf="@+id/vertical_divider" android:layout_alignParentStart="true"/>
    <Button android:textSize="16sp" android:textColor="@color/gsdk_rating_black" android:gravity="center" android:id="@+id/submit" android:background="@null" android:layout_width="wrap_content" android:layout_height="45dp" android:text="@string/gsdk_rating_submit" android:singleLine="true" android:layout_below="@+id/horizontal_divider" android:textAllCaps="false" android:layout_toEndOf="@+id/vertical_divider" android:layout_alignParentEnd="true"/>
</RelativeLayout>
